{
  "name": "@wireassist/command-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "predev:api": "node scripts/free-dev-port.mjs api",
    "dev:api": "tsx src/api/server.ts",
    "predev:web": "node scripts/free-dev-port.mjs web",
    "dev:web": "node scripts/wait-for-api.mjs && node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "concurrently -n api,web -c blue,green \"pnpm start:api\" \"pnpm start:web\"",
    "start:api": "tsx src/api/server.ts",
    "start:web": "node scripts/run-next.mjs start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@hono/node-server": "^1.14.0",
    "@wireassist/agent-admin": "workspace:*",
    "@wireassist/agent-content": "workspace:*",
    "@wireassist/agent-research": "workspace:*",
    "@wireassist/agent-ops": "workspace:*",
    "@wireassist/agent-gtm": "workspace:*",
    "@wireassist/agent-github": "workspace:*",
    "@wireassist/core": "workspace:*",
    "@wireassist/trendpost-mcp": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.27",
    "next": "16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "jest": "^30.4.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.3"
  }
}
